# Copy to .env and adjust (never commit real secrets)
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/taskMarketplaceDB

# Required for sessions (app.js / express-session). Generate a long random string for production.
SESSION_SECRET=replace-with-long-random-string-in-production

# --- Docker Compose (docker compose up --build) ---
# Compose reads .env from the project root. Typical Docker values:
#   MONGODB_URI=mongodb://mongo:27017/taskMarketplaceDB   # set automatically in docker-compose.yml
#   SESSION_SECRET=<your-secret>                          # required — do not commit
#   PORT=3000
#   NODE_ENV=development                                # default in compose for http://localhost cookies
#
# Open http://localhost:3000 after: docker compose up --build
